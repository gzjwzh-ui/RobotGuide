<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- 用户消息（右侧） -->
    <LinearLayout
        android:id="@+id/userMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:background="@drawable/bg_bubble_user"
            android:padding="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="500dp"
                android:textColor="@color/bubble_user_text"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp" />

            <!-- 用户消息来源标签（语言+置信度） -->
            <LinearLayout
                android:id="@+id/userTagRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvUserLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF99"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvUserConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#FFFFFF99"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 机器人消息（左侧） -->
    <LinearLayout
        android:id="@+id/botMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="gone">

        <!-- 机器人头像（emoji 🤖 替代缺失的占位图） -->
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:text="🤖"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_bubble_bot"
            android:padding="16dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:orientation="vertical">

            <!-- 加载动画 -->
            <ProgressBar
                android:id="@+id/pbLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:indeterminateTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvBotMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="500dp"
                android:textColor="@color/bubble_bot_text"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp" />

            <!-- 语音播放条（可选） -->
            <LinearLayout
                android:id="@+id/audioPlayBar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/bg_surface"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:visibility="gone">

                <!-- 播放按钮用 emoji ▶ 替代缺失的系统图标 -->
                <TextView
                    android:id="@+id/btnAudioPlay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/colorPrimary"
                    android:textSize="20sp"
                    android:contentDescription="播放" />

                <!-- 波形进度模拟 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="18dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View android:layout_width="2dp" android:layout_height="8dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="14dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="6dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="16dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="4dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="14dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="10dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="6dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="4dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="10dp" android:background="@color/text_hint" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="00:08"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 动作/LED 标签行 -->
            <LinearLayout
                android:id="@+id/tagRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTagAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tag_action"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="#0A1628"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTagLed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_led"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="#0A1628"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 来源标签（固定问答/AI生成/兜底） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="来源"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
