<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 用户消息（右侧） -->
    <LinearLayout
        android:id="@+id/userMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:background="@drawable/bg_bubble_user"
            android:padding="14dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="420dp"
                android:textColor="@color/bubble_user_text"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <!-- 用户消息来源标签（语言+置信度） -->
            <LinearLayout
                android:id="@+id/userTagRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvUserLang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF99"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvUserConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#FFFFFF99"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 机器人消息（左侧） -->
    <LinearLayout
        android:id="@+id/botMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="gone">

        <!-- 头像 -->
        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/sym_def_app_icon"
                android:contentDescription="机器人" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_bubble_bot"
            android:padding="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:orientation="vertical">

            <!-- 加载动画 -->
            <ProgressBar
                android:id="@+id/pbLoading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:visibility="gone"
                android:indeterminateTint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tvBotMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="420dp"
                android:textColor="@color/bubble_bot_text"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <!-- 语音播放条（可选） -->
            <LinearLayout
                android:id="@+id/audioPlayBar"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/bg_surface"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnAudioPlay"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_media_play"
                    android:contentDescription="播放"
                    app:tint="@color/colorPrimary" />

                <!-- 波形进度模拟 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="16dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View android:layout_width="2dp" android:layout_height="8dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="6dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="14dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="10dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="4dp" android:background="@color/colorPrimary" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="12dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="8dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="6dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="10dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="4dp" android:background="@color/text_hint" android:layout_marginEnd="2dp" />
                    <View android:layout_width="2dp" android:layout_height="8dp" android:background="@color/text_hint" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="00:08"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 动作/LED 标签行 -->
            <LinearLayout
                android:id="@+id/tagRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTagAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tag_action"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#0A1628"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTagLed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_led"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#0A1628"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- 来源标签（固定问答/AI生成/兜底） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="来源"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
