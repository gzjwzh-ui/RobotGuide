<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 顶部区域 - 欢迎语 -->
    <LinearLayout
        android:id="@+id/welcomeSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo/动画区域 -->
        <ImageView
            android:id="@+id/robotAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/sym_def_app_icon"
            android:background="@drawable/bg_card"
            android:padding="8dp"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- 快捷功能区域 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuickActions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="24dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/welcomeSection"
        app:layout_constraintBottom_toTopOf="@id/btnQuickChat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部主要按钮 - 快速对话 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuickChat"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="48dp"
        android:text="@string/quick_chat"
        android:textSize="22sp"
        android:textAllCaps="false"
        app:cornerRadius="36dp"
        app:backgroundTint="@color/colorPrimary"
        app:icon="@android:drawable/ic_btn_speak_now"
        app:iconSize="32dp"
        app:iconTint="@color/text_primary"
        app:iconPadding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 右下角设置按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        style="@style/ButtonIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:icon="@android:drawable/ic_menu_manage"
        app:iconSize="32dp"
        app:iconTint="@color/text_secondary"
        android:backgroundTint="@color/bg_card"
        app:cornerRadius="28dp"
        android:contentDescription="@string/settings_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp"
        android:layout_marginEnd="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
